# This file is a template for the environment variables.
# Copy this to a new file named .env and fill in the values.


# --- Credentials & Secrets ---
# These should be unique for your local setup or production environment.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
GRAFANA_ADMIN_PASSWORD=admin

# --- General Configuration ---
# The S3-compatible bucket name for MLflow artifacts.
MLFLOW_S3_BUCKET=mlflow
# The name used to register models in the MLflow Model Registry.
MODEL_NAME=ModelOpsStudioModel
# The expected number of features for your model's input.
EXPECTED_FEATURE_COUNT=30

# --- External Ports ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
REDIS_PORT=6379
MODEL_SERVER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
FRONTEND_DEV_PORT=5173

# --- URLs for Client-Side Access (from your browser) ---
# Ensure the port matches MODEL_SERVER_PORT.
VITE_API_BASE_URL=http://localhost:8000
MODEL_SERVER_HEALTH_URL=http://localhost:8000/health
TARGET_HOST=http://localhost:8000